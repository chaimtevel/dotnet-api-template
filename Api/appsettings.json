{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ApiTemplate;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "GELF": {
      "Host": "logs.bitbean.com",
      "Port": 12201,
      "AdditionalFields": {
        "facility": "ApiTemplate"
      },
      "LogLevel": {
        "Default": "Warning"
      },
      "DebugGraylog": false
    }
  },
  "AllowedHosts": "*",
  "CorsAllowedOrigins": [
    "http://localhost:3000"
  ]
}
